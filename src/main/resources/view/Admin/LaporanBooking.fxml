<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1400.0"
            style="-fx-background-color: #F8FAFC;"
            stylesheets="@../../css/style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kosku.controller.admin.LaporanBookingAdminController">
    <top>
        <fx:include fx:id="navbar" source="NavbarAdmin.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <VBox spacing="20.0" styleClass="page-content">
                    <padding><Insets top="25.0" right="40.0" bottom="30.0" left="40.0" /></padding>

                    <VBox spacing="5.0">
                        <Label text="📋 Laporan Booking" styleClass="label-title" />
                        <Label text="Lihat semua booking dari penyewa ke kos di sistem"
                               style="-fx-text-fill: #64748B; -fx-font-size: 12px;" />
                    </VBox>
                    <Separator />

                    <!-- FILTERS -->
                    <HBox spacing="10.0">
                        <DatePicker prefWidth="140.0" promptText="Dari Tanggal" />
                        <DatePicker prefWidth="140.0" promptText="Sampai Tanggal" />
                        <ComboBox prefWidth="150.0" promptText="Status Booking">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Semua" />
                                    <String fx:value="Pending" />
                                    <String fx:value="Confirmed" />
                                    <String fx:value="Active" />
                                    <String fx:value="Completed" />
                                    <String fx:value="Cancelled" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <TextField prefWidth="250.0" promptText="Cari nama atau ID..." />
                        <Button text="🔍 Filter" styleClass="btn-secondary" prefWidth="100" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="↻ Reset" styleClass="btn-outline" prefWidth="80" />
                    </HBox>

                    <!-- STATISTICS -->
                    <HBox spacing="15.0">
                        <VBox spacing="6.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Booking" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblTotalBooking" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;" />
                        </VBox>
                        <VBox spacing="6.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Booking Aktif" style="-fx-text-fill:#10b981;-fx-font-size:12px;" />
                            <Label fx:id="lblBookingAktif" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#10b981;" />
                        </VBox>
                        <VBox spacing="6.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Booking Pending" style="-fx-text-fill:#f59e0b;-fx-font-size:12px;" />
                            <Label fx:id="lblBookingPending" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#f59e0b;" />
                        </VBox>
                    </HBox>

                    <!-- TABLE -->
                    <VBox spacing="10.0" styleClass="card">
                        <Label text="Detail Booking" styleClass="label-subtitle" />
                        <TableView fx:id="tabelBooking" prefHeight="350.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="100.0" text="ID Booking" />
                                <TableColumn fx:id="colPenyewa" prefWidth="200.0" text="Penyewa" />
                                <TableColumn fx:id="colKos" prefWidth="200.0" text="Kos" />
                                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                                <TableColumn fx:id="colTotal" prefWidth="150.0" text="Total" />
                                <TableColumn fx:id="colTanggal" prefWidth="150.0" text="Tanggal" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>