<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1400.0"
            style="-fx-background-color: #F8FAFC;"
            stylesheets="@../../css/style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kosku.controller.admin.ManagementPenggunaController">
    <top>
        <fx:include fx:id="navbar" source="NavbarAdmin.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <VBox spacing="20.0" styleClass="page-content">
                    <padding><Insets top="25.0" right="40.0" bottom="30.0" left="40.0" /></padding>

                    <!-- HEADER -->
                    <VBox spacing="5.0">
                        <Label text="👥 Manajemen Pengguna &amp; Verifikasi" styleClass="label-title" />
                        <Label text="Lihat, verifikasi, atau hapus akun pengguna"
                               style="-fx-text-fill: #64748B; -fx-font-size: 12px;" />
                    </VBox>
                    <Separator />

                    <!-- SEARCH & FILTER -->
                    <HBox spacing="10.0">
                        <TextField promptText="Cari nama, email, atau role..." prefWidth="300"
                                   styleClass="text-field" />
                        <ComboBox promptText="Filter Role" prefWidth="150" styleClass="combo-box">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Semua" />
                                    <String fx:value="Admin" />
                                    <String fx:value="Pemilik Kos" />
                                    <String fx:value="Penyewa" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Button text="🔍 Cari" styleClass="btn-secondary" prefWidth="90" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="↻ Reset" styleClass="btn-outline" prefWidth="80" />
                    </HBox>

                    <!-- STATISTICS -->
                    <HBox spacing="15.0">
                        <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Total Pengguna" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblStatTotal" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;" />
                        </VBox>
                        <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Admin" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblStatAdmin" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#31487A;" />
                        </VBox>
                        <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Pemilik Kos" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblStatPemilik" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#31487A;" />
                        </VBox>
                        <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Penyewa" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblStatPenyewa" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#31487A;" />
                        </VBox>
                    </HBox>

                    <!-- TABLE -->
                    <VBox styleClass="card" spacing="10.0">
                        <Label text="Daftar Pengguna" styleClass="label-subtitle" />
                        <TableView fx:id="tablePengguna" prefHeight="480.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId"       text="ID"            prefWidth="50" />
                                <TableColumn fx:id="colUsername" text="Nama Pengguna" prefWidth="200" />
                                <TableColumn fx:id="colEmail"    text="Email"          prefWidth="250" />
                                <TableColumn fx:id="colRole"     text="Role"           prefWidth="120" />
                                <TableColumn fx:id="colNoHp"     text="No. Telepon"    prefWidth="150" />
                                <TableColumn fx:id="colStatus"   text="Status"         prefWidth="120" />
                                <TableColumn fx:id="colAction"   text="Aksi"           prefWidth="200" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
