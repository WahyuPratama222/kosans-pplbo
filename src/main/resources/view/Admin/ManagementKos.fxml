<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1400.0"
            style="-fx-background-color: #F8FAFC;"
            stylesheets="@../../css/style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kosku.controller.admin.ManagementKosController">
    <top>
        <fx:include fx:id="navbar" source="NavbarAdmin.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <VBox spacing="20.0" styleClass="page-content">
                    <padding><Insets top="25.0" right="40.0" bottom="30.0" left="40.0" /></padding>

                    <!-- HEADER -->
                    <VBox spacing="5.0">
                        <Label text="🏠 Manajemen Kos &amp; Verifikasi" styleClass="label-title" />
                        <Label text="Lihat status, verifikasi, dan kelola data kos"
                               style="-fx-text-fill: #64748B; -fx-font-size: 12px;" />
                    </VBox>
                    <Separator />

                    <!-- SEARCH -->
                    <HBox spacing="10.0">
                        <TextField promptText="Cari berdasarkan nama, lokasi, atau pemilik..."
                                   prefWidth="300" styleClass="text-field" />
                        <ComboBox promptText="Urutkan" prefWidth="150" styleClass="combo-box">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Nama" />
                                    <String fx:value="Lokasi" />
                                    <String fx:value="Harga" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Button text="🔍 Cari" styleClass="btn-secondary" prefWidth="90" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="↻ Reset" styleClass="btn-outline" prefWidth="80" />
                    </HBox>

                    <!-- STATISTICS -->
                    <HBox spacing="15.0">
                        <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Total Kos" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblStatTotalKos" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;" />
                        </VBox>
                        <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Sudah Verified" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblStatVerified" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#10B981;" />
                        </VBox>
                        <VBox styleClass="stat-card" spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Belum Verified" style="-fx-text-fill:#64748B;-fx-font-size:12px;" />
                            <Label fx:id="lblStatBelumVerified" text="0"
                                   style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#EF4444;" />
                        </VBox>
                    </HBox>

                    <!-- TABLE -->
                    <VBox spacing="10.0">
                        <Label text="Daftar Kos" styleClass="label-subtitle" />
                        <TableView fx:id="tableKos" prefHeight="480.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId"       text="ID"          prefWidth="50" />
                                <TableColumn fx:id="colNamaKos"  text="Nama Kos"    prefWidth="200" />
                                <TableColumn fx:id="colPemilik"  text="Pemilik"     prefWidth="150" />
                                <TableColumn fx:id="colTipeKos"  text="Tipe"        prefWidth="100" />
                                <TableColumn fx:id="colHarga"    text="Harga (Rp)"  prefWidth="150" />
                                <TableColumn fx:id="colStatus"   text="Status"      prefWidth="120" />
                                <TableColumn fx:id="colAction"   text="Aksi"        prefWidth="250" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
