<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1400.0"
            style="-fx-background-color: #F8FAFC;"
            stylesheets="@../../css/style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kosku.controller.admin.LaporanPembayaranAdminController">
    <top>
        <fx:include fx:id="navbar" source="NavbarAdmin.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <VBox spacing="20.0" styleClass="page-content">
                    <padding><Insets top="25.0" right="40.0" bottom="30.0" left="40.0" /></padding>

                    <VBox spacing="5.0">
                        <Label text="💰 Laporan Pembayaran" styleClass="label-title" />
                        <Label text="Verifikasi dan kelola semua data pembayaran penyewa"
                               style="-fx-text-fill: #64748B; -fx-font-size: 12px;" />
                    </VBox>
                    <Separator />

                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <TableView fx:id="mainTable" prefHeight="500.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId"        text="ID Pembayaran" prefWidth="100" />
                                <TableColumn fx:id="colBookingId" text="ID Booking"    prefWidth="100" />
                                <TableColumn fx:id="colPenyewa"   text="Penyewa"       prefWidth="200" />
                                <TableColumn fx:id="colJumlah"    text="Jumlah"        prefWidth="150" />
                                <TableColumn fx:id="colStatus"    text="Status"        prefWidth="150" />
                                <TableColumn fx:id="colTanggal"   text="Tanggal"       prefWidth="150" />
                                <TableColumn fx:id="colAction"    text="Aksi"          prefWidth="200" />
                            </columns>
                        </TableView>
                    </VBox>

                    <HBox alignment="CENTER" spacing="10.0">
                        <Button text="← Sebelumnya" styleClass="btn-outline" prefWidth="120" />
                        <Label text="Halaman 1" style="-fx-font-weight: bold;" />
                        <Button text="Selanjutnya →" styleClass="btn-outline" prefWidth="120" />
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>