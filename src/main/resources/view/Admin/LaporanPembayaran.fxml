<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosku.controller.admin.LaporanPembayaranAdminController">
    <top>
        <fx:include source="NavbarAdmin.fxml" />
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true">
            <content>
                <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: #F8FAFC;">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Button fx:id="btnKembali" text="← Kembali ke Dashboard" style="-fx-background-color: transparent; -fx-border-color: #64748B; -fx-border-radius: 5; -fx-text-fill: #1E2E4F; -fx-padding: 5 10; -fx-cursor: hand;" />
                                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Laporan Keseluruhan" />
                                <Separator />
                            </children>
                        </VBox>

                        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="mainTable" prefHeight="400.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID Pembayaran" />
                                        <TableColumn fx:id="colBookingId" prefWidth="100.0" text="ID Booking" />
                                        <TableColumn fx:id="colPenyewa" prefWidth="200.0" text="Penyewa" />
                                        <TableColumn fx:id="colJumlah" prefWidth="150.0" text="Jumlah" />
                                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                                        <TableColumn fx:id="colTanggal" prefWidth="150.0" text="Tanggal" />
                                        <TableColumn fx:id="colAction" prefWidth="200.0" text="Aksi" />
                                    </columns> </TableView> </children>
                        </VBox>

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button text="← Sebelumnya" />
                                <Label text="Halaman 1" />
                                <Button text="Selanjutnya →" />
                                <ComboBox prefWidth="80.0" promptText="10">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="10" />
                                            <String fx:value="25" />
                                            <String fx:value="50" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>