<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosku.controller.admin.DashboardAdminController" stylesheets="@../../css/style.css">
    <!-- TOP NAVBAR -->
    <top>
        <BorderPane prefHeight="60.0" prefWidth="1920.0" style="-fx-background-color: linear-gradient(to right, #31487A, #8FB3E2);" styleClass="navbar-admin">
            <left>
                <Label text="🏢 Admin Dashboard" style="-fx-text-fill: white;" styleClass="navbar-title" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                </Label>
            </left>
            <right>
                <HBox spacing="20" alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
                    <Label text="👤 Administrator" style="-fx-text-fill: white; -fx-font-size: 12px;" />
                    <Button fx:id="btnLogout" text="Logout" styleClass="btn-danger" style="-fx-padding: 5 15;" />
                    <padding>
                        <Insets right="20.0" />
                    </padding>
                </HBox>
            </right>
        </BorderPane>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="250.0" prefHeight="700.0" style="-fx-background-color: #1E2E4F;" spacing="10" styleClass="side-menu">
            <Label text="MENU" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;" />
            <Separator />
            
            <Button fx:id="btnDashboard" text="📊 Dashboard" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            <Button fx:id="btnManajemenPengguna" text="👥 Manajemen Pengguna" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            <Button fx:id="btnManajemenKos" text="🏠 Manajemen Kos" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            <Button fx:id="btnLaporanPembayaran" text="💰 Laporan Pembayaran" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            <Button fx:id="btnLaporanBooking" text="📋 Laporan Booking" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            <Button fx:id="btnVerifikasiPengguna" text="✔️ Verifikasi Pengguna" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            <Button fx:id="btnVerifikasiKos" text="✔️ Verifikasi Kos" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            <Button text="⚙️ Pengaturan Sistem" styleClass="btn-outline" style="-fx-alignment: center-left; -fx-text-alignment: left; -fx-max-width: INFINITY; -fx-padding: 10 15; -fx-border-radius: 4; -fx-text-fill: white;" />
            
            <Region VBox.vgrow="ALWAYS" />
            <Separator />
            <Label text="v1.0 © 2026" style="-fx-text-fill: #8FB3E2; -fx-font-size: 10px;" />
            <padding>
                <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
            </padding>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <fx:include source="MainMenuAdmin.fxml" />
    </center>
</BorderPane>
