<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosku.controller.admin.VerifikasiPenggunaController" stylesheets="@../../css/style.css">
    <!-- TOP NAVBAR -->
    <top>
        <BorderPane prefHeight="60.0" prefWidth="1920.0" style="-fx-background-color: linear-gradient(to right, #31487A, #8FB3E2);" styleClass="navbar-admin">
            <left>
                <Label text="✔️ Verifikasi Pengguna" style="-fx-text-fill: white;" styleClass="navbar-title" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                </Label>
            </left>
            <right>
                <Button fx:id="btnKembali" text="← Kembali" styleClass="btn-outline" style="-fx-text-fill: white; -fx-padding: 5 15; -fx-border-color: white;" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets right="20.0" />
                    </padding>
                    <BorderPane.margin>
                        <Insets right="20.0" />
                    </BorderPane.margin>
                </Button>
            </right>
        </BorderPane>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #F8FAFC;">
            <VBox spacing="20" styleClass="page-content" style="-fx-padding: 30;">
                <!-- HEADER -->
                <VBox spacing="10">
                    <Label text="Daftar Pendaftar Pemilik (Belum Diverifikasi)" styleClass="label-title" />
                    <Label text="Periksa data calon pemilik kos dan tentukan apakah akan disetujui atau ditolak." style="-fx-text-fill: #64748B; -fx-font-size: 14px;" />
                    <Separator />
                </VBox>

                <TableView fx:id="tablePengguna" VBox.vgrow="ALWAYS" prefHeight="600.0">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colUsername" text="Username" prefWidth="200" />
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="250" />
                        <TableColumn fx:id="colNoHp" text="No HP" prefWidth="150" />
                        <TableColumn fx:id="colAction" text="Aksi" prefWidth="200" />
                    </columns>
                </TableView>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
