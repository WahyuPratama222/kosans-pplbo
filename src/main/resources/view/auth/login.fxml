<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Rectangle?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kosku.controller.auth.LoginController"
      styleClass="auth-root" prefWidth="1100.0" prefHeight="700.0" stylesheets="@../../css/style.css">

    <!-- ===== LEFT PANEL: BRANDING ===== -->
    <VBox styleClass="auth-left-panel" HBox.hgrow="ALWAYS" maxWidth="520.0" minWidth="420.0"
          alignment="CENTER" spacing="24.0">

        <!-- Logo + App Name -->
        <VBox alignment="CENTER" spacing="10.0">
            <Label styleClass="auth-brand-icon" text="🏠" />
            <Label styleClass="auth-brand-name" text="KosKu" />
            <Label styleClass="auth-brand-tagline" text="Platform Kos Terpercaya #1 Indonesia"
                   wrapText="true" alignment="CENTER" textAlignment="CENTER" />
        </VBox>

        <!-- Feature Pills -->
        <VBox alignment="CENTER" spacing="12.0">
            <HBox alignment="CENTER" spacing="10.0">
                <Label styleClass="auth-feature-pill" text="✅  Ribuan Kos Tersedia" />
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
                <Label styleClass="auth-feature-pill" text="🔒  Transaksi Aman" />
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
                <Label styleClass="auth-feature-pill" text="💬  Chat Langsung Pemilik" />
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
                <Label styleClass="auth-feature-pill" text="⭐  Review Terverifikasi" />
            </HBox>
        </VBox>

        <!-- Decoration dots -->
        <Label styleClass="auth-left-decor" text="• • •" />

    </VBox>

    <!-- ===== DIVIDER ===== -->
    <Separator orientation="VERTICAL" styleClass="auth-divider" />

    <!-- ===== RIGHT PANEL: FORM ===== -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER">
        <ScrollPane fitToWidth="true" styleClass="auth-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox styleClass="auth-form-container" alignment="CENTER" spacing="0.0">
                    <padding>
                        <Insets top="60.0" bottom="60.0" left="60.0" right="60.0"/>
                    </padding>

                    <!-- Header -->
                    <VBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label styleClass="auth-form-title" text="Selamat Datang Kembali 👋" />
                        <Label styleClass="auth-form-subtitle" text="Masuk ke akun KosKu Anda" />
                    </VBox>

                    <Region prefHeight="32.0" />

                    <!-- Form Fields -->
                    <VBox spacing="18.0">

                        <!-- Email / Username -->
                        <VBox spacing="6.0">
                            <Label styleClass="auth-field-label" text="Email atau Username" />
                            <TextField fx:id="emailField"
                                       styleClass="auth-field"
                                       promptText="Masukkan email atau username"
                                       prefHeight="48.0"
                                       prefWidth="380.0"/>
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="6.0">
                            <Label styleClass="auth-field-label" text="Password" />
                            <PasswordField fx:id="passwordField"
                                          styleClass="auth-field"
                                          promptText="Masukkan password Anda"
                                          prefHeight="48.0"
                                          prefWidth="380.0"/>
                        </VBox>

                        <!-- Remember me row -->
                        <HBox alignment="CENTER_LEFT">
                            <CheckBox styleClass="auth-checkbox" text="Ingat saya" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="auth-link-small" text="Lupa password?" style="-fx-cursor: hand;" />
                        </HBox>

                    </VBox>

                    <Region prefHeight="24.0" />

                    <!-- Login Button -->
                    <Button fx:id="loginButton"
                            text="Masuk ke Akun"
                            onAction="#handleLogin"
                            styleClass="auth-btn-submit"
                            prefHeight="50.0"
                            prefWidth="380.0"
                            mnemonicParsing="false"/>

                    <Region prefHeight="24.0" />

                    <!-- Divider -->
                    <HBox alignment="CENTER" spacing="10.0">
                        <Separator HBox.hgrow="ALWAYS" />
                        <Label styleClass="auth-divider-label" text="atau" />
                        <Separator HBox.hgrow="ALWAYS" />
                    </HBox>

                    <Region prefHeight="20.0" />

                    <!-- Register Link -->
                    <HBox alignment="CENTER" spacing="5.0">
                        <Label styleClass="auth-muted-text" text="Belum punya akun?" />
                        <Label onMouseClicked="#handleGoToRegister"
                               styleClass="auth-link"
                               text="Daftar Sekarang →"
                               style="-fx-cursor: hand;" />
                    </HBox>

                    <Region prefHeight="16.0" />

                    <!-- Footer note -->
                    <Label styleClass="auth-footer-note"
                           text="Dengan masuk, Anda menyetujui Syarat &amp; Ketentuan KosKu"
                           wrapText="true"
                           alignment="CENTER"
                           textAlignment="CENTER"
                           prefWidth="380.0"/>

                </VBox>
            </content>
        </ScrollPane>
    </VBox>

</HBox>
