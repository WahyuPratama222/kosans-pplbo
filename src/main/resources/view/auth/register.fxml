<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kosku.controller.auth.RegisterController"
      styleClass="auth-root" prefWidth="1100.0" prefHeight="700.0" stylesheets="@../css/style.css">

    <!-- ===== LEFT PANEL: BRANDING ===== -->
    <VBox styleClass="auth-left-panel" HBox.hgrow="ALWAYS" maxWidth="520.0" minWidth="420.0"
          alignment="CENTER" spacing="24.0">

        <!-- Logo + App Name -->
        <VBox alignment="CENTER" spacing="10.0">
            <Label styleClass="auth-brand-icon" text="🏠" />
            <Label styleClass="auth-brand-name" text="KosKu" />
            <Label styleClass="auth-brand-tagline" text="Bergabung dan temukan kos impianmu!"
                   wrapText="true" alignment="CENTER" textAlignment="CENTER" />
        </VBox>

        <!-- Register Benefits -->
        <VBox alignment="CENTER_LEFT" spacing="16.0" styleClass="auth-benefit-box">
            <padding><Insets top="10.0" bottom="10.0" left="30.0" right="30.0"/></padding>
            <Label styleClass="auth-benefit-title" text="Keuntungan Bergabung" />
            <VBox spacing="12.0">
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label styleClass="auth-benefit-icon" text="🏡" />
                    <VBox spacing="2.0">
                        <Label styleClass="auth-benefit-item-title" text="Pemilik Kos" />
                        <Label styleClass="auth-benefit-item-desc" text="Kelola kos dan terima penyewa dengan mudah" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label styleClass="auth-benefit-icon" text="🔍" />
                    <VBox spacing="2.0">
                        <Label styleClass="auth-benefit-item-title" text="Penyewa Kos" />
                        <Label styleClass="auth-benefit-item-desc" text="Cari dan booking kos terbaik di sekitarmu" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label styleClass="auth-benefit-icon" text="🔒" />
                    <VBox spacing="2.0">
                        <Label styleClass="auth-benefit-item-title" text="Aman &amp; Terpercaya" />
                        <Label styleClass="auth-benefit-item-desc" text="Data dan transaksi Anda terlindungi" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <Label styleClass="auth-left-decor" text="• • •" />

    </VBox>

    <!-- ===== DIVIDER ===== -->
    <Separator orientation="VERTICAL" styleClass="auth-divider" />

    <!-- ===== RIGHT PANEL: FORM ===== -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER">
        <ScrollPane fitToWidth="true" styleClass="auth-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox styleClass="auth-form-container" alignment="CENTER" spacing="0.0">
                    <padding>
                        <Insets top="40.0" bottom="40.0" left="60.0" right="60.0"/>
                    </padding>

                    <!-- Header -->
                    <VBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label styleClass="auth-form-title" text="Buat Akun Baru ✨" />
                        <Label styleClass="auth-form-subtitle" text="Daftar sebagai Pemilik atau Penyewa Kos" />
                    </VBox>

                    <Region prefHeight="24.0" />

                    <!-- ===== ROLE TOGGLE ===== -->
                    <VBox spacing="8.0">
                        <Label styleClass="auth-field-label" text="Daftar Sebagai" />
                        <HBox styleClass="role-toggle-container" alignment="CENTER" spacing="0.0" prefWidth="380.0">
                            <Button fx:id="btnRolePemilik"
                                    text="🏡  Pemilik Kos"
                                    styleClass="role-btn, role-btn-active"
                                    onAction="#handleSelectPemilik"
                                    prefWidth="190.0"
                                    prefHeight="44.0"
                                    mnemonicParsing="false"/>
                            <Button fx:id="btnRolePenyewa"
                                    text="🔍  Penyewa Kos"
                                    styleClass="role-btn"
                                    onAction="#handleSelectPenyewa"
                                    prefWidth="190.0"
                                    prefHeight="44.0"
                                    mnemonicParsing="false"/>
                        </HBox>
                    </VBox>

                    <Region prefHeight="20.0" />

                    <!-- Form Fields -->
                    <VBox spacing="14.0">

                        <!-- Username -->
                        <VBox spacing="6.0">
                            <Label styleClass="auth-field-label" text="Username" />
                            <TextField fx:id="usernameField"
                                       styleClass="auth-field"
                                       promptText="Buat username unik Anda"
                                       prefHeight="48.0"
                                       prefWidth="380.0"/>
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="6.0">
                            <Label styleClass="auth-field-label" text="Email" />
                            <TextField fx:id="emailField"
                                       styleClass="auth-field"
                                       promptText="Masukkan alamat email Anda"
                                       prefHeight="48.0"
                                       prefWidth="380.0"/>
                        </VBox>

                        <!-- Nomor HP -->
                        <VBox spacing="6.0">
                            <Label styleClass="auth-field-label" text="Nomor HP (Opsional)" />
                            <TextField fx:id="nomorHpField"
                                       styleClass="auth-field"
                                       promptText="Contoh: 081234567890"
                                       prefHeight="48.0"
                                       prefWidth="380.0"/>
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="6.0">
                            <Label styleClass="auth-field-label" text="Password" />
                            <PasswordField fx:id="passwordField"
                                          styleClass="auth-field"
                                          promptText="Minimal 6 karakter"
                                          prefHeight="48.0"
                                          prefWidth="380.0"/>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="6.0">
                            <Label styleClass="auth-field-label" text="Konfirmasi Password" />
                            <PasswordField fx:id="confirmPasswordField"
                                          styleClass="auth-field"
                                          promptText="Ulangi password Anda"
                                          prefHeight="48.0"
                                          prefWidth="380.0"/>
                        </VBox>

                    </VBox>

                    <Region prefHeight="20.0" />

                    <!-- Role Info Banner -->
                    <HBox fx:id="roleInfoBanner" styleClass="role-info-banner" spacing="10.0" alignment="CENTER_LEFT" prefWidth="380.0">
                        <padding><Insets top="10.0" bottom="10.0" left="14.0" right="14.0"/></padding>
                        <Label fx:id="roleInfoIcon" text="🏡" styleClass="role-banner-icon"/>
                        <Label fx:id="roleInfoText"
                               text="Anda akan terdaftar sebagai Pemilik Kos"
                               styleClass="role-banner-text"
                               wrapText="true"/>
                    </HBox>

                    <Region prefHeight="16.0" />

                    <!-- Register Button -->
                    <Button fx:id="registerButton"
                            text="Buat Akun Sekarang"
                            onAction="#handleRegister"
                            styleClass="auth-btn-submit"
                            prefHeight="50.0"
                            prefWidth="380.0"
                            mnemonicParsing="false"/>

                    <Region prefHeight="16.0" />

                    <!-- Login Link -->
                    <HBox alignment="CENTER" spacing="5.0">
                        <Label styleClass="auth-muted-text" text="Sudah punya akun?" />
                        <Label onMouseClicked="#handleGoToLogin"
                               styleClass="auth-link"
                               text="Masuk Sekarang →"
                               style="-fx-cursor: hand;" />
                    </HBox>

                    <Region prefHeight="10.0" />

                    <!-- Footer note -->
                    <Label styleClass="auth-footer-note"
                           text="Dengan mendaftar, Anda menyetujui Syarat &amp; Ketentuan KosKu"
                           wrapText="true"
                           alignment="CENTER"
                           textAlignment="CENTER"
                           prefWidth="380.0"/>

                </VBox>
            </content>
        </ScrollPane>
    </VBox>

</HBox>
