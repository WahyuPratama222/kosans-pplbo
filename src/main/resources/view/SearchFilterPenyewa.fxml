<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kosku.controller.penyewa.SearchFilterController"
            stylesheets="@css/style.css">

    <!-- ===== TOP: NAVBAR KONSISTEN ===== -->
    <top>
        <fx:include source="penyewa/NavbarPenyewa.fxml" />
    </top>

    <!-- ===== LEFT: SIDEBAR FILTER ===== -->
    <left>
        <VBox prefWidth="300.0" spacing="20.0" styleClass="filter-sidebar"
              style="-fx-border-color: transparent #E8EDF5 transparent transparent; -fx-border-width: 0 1 0 0;">

            <Label styleClass="filter-header" text="🎛️ Filter Pencarian" prefWidth="260.0" />

            <!-- Rentang Harga -->
            <VBox spacing="8.0">
                <Label styleClass="filter-section-label" text="Rentang Harga (per bulan)" />
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <TextField fx:id="minPriceField" prefWidth="115.0" promptText="Min (Rp)"
                               styleClass="filter-textfield" />
                    <Label style="-fx-text-fill: #94A3B8; -fx-font-weight: bold;" text="—" />
                    <TextField fx:id="maxPriceField" prefWidth="115.0" promptText="Max (Rp)"
                               styleClass="filter-textfield" />
                </HBox>
            </VBox>

            <!-- Tipe Kamar -->
            <VBox spacing="8.0">
                <Label styleClass="filter-section-label" text="Tipe Kamar" />
                <VBox spacing="6.0">
                    <CheckBox fx:id="regulerCheck" text="Reguler"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                    <CheckBox fx:id="exclusiveCheck" text="Exclusive"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                </VBox>
            </VBox>

            <!-- Tipe Kos -->
            <VBox spacing="8.0">
                <Label styleClass="filter-section-label" text="Tipe Kos" />
                <VBox spacing="6.0">
                    <CheckBox fx:id="putraCheck" text="🚹  Putra"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                    <CheckBox fx:id="putriCheck" text="🚺  Putri"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                    <CheckBox fx:id="campurCheck" text="👥  Campur"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                </VBox>
            </VBox>

            <!-- Fasilitas -->
            <VBox spacing="8.0">
                <Label styleClass="filter-section-label" text="Fasilitas" />
                <VBox spacing="6.0">
                    <CheckBox fx:id="wifiCheck" text="📶  WiFi"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                    <CheckBox fx:id="acCheck" text="❄  AC"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                    <CheckBox fx:id="kmDalamCheck" text="🛁  Kamar Mandi Dalam"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                    <CheckBox fx:id="parkirCheck" text="🅿  Parkir Motor"
                              style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                </VBox>
            </VBox>

            <!-- Urutkan -->
            <VBox spacing="8.0">
                <Label styleClass="filter-section-label" text="Urutkan Berdasarkan" />
                <ComboBox fx:id="sortCombo" prefWidth="260.0" promptText="Pilih urutan..."
                          styleClass="filter-combobox" />
            </VBox>

            <!-- Tombol Aksi -->
            <VBox spacing="10.0" style="-fx-padding: 8 0 0 0;">
                <Button maxWidth="Infinity" onAction="#handleApplyFilter"
                        styleClass="btn-apply-filter"
                        text="✅  Terapkan Filter" />
                <Button maxWidth="Infinity" onAction="#handleResetFilter"
                        style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 13px; -fx-cursor: hand;"
                        text="🔄  Reset Semua" />
            </VBox>
        </VBox>
    </left>

    <!-- ===== CENTER: HASIL PENCARIAN ===== -->
    <center>
        <VBox spacing="0.0" style="-fx-background-color: #F0F4FF;">

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: white; -fx-padding: 20 32 20 32; -fx-border-color: transparent transparent #E8EDF5 transparent; -fx-border-width: 0 0 1 0;">
                <HBox alignment="CENTER_LEFT" spacing="0.0"
                      style="-fx-background-color: #F8FAFC; -fx-background-radius: 40; -fx-border-color: #CBD5E1; -fx-border-radius: 40; -fx-border-width: 1.5;"
                      HBox.hgrow="ALWAYS" prefHeight="46.0">
                    <Label style="-fx-font-size: 16px; -fx-padding: 0 0 0 18;" text="🔍" />
                    <TextField fx:id="searchField" prefHeight="44.0"
                               promptText="Cari nama kos atau lokasi..."
                               style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-border-color: transparent; -fx-padding: 0 16 0 10;"
                               HBox.hgrow="ALWAYS" />
                </HBox>
                <Button onAction="#handleSearch" prefHeight="46.0" prefWidth="120.0"
                        style="-fx-background-color: #2D6BE4; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 40; -fx-cursor: hand;"
                        text="Cari" />
            </HBox>

            <!-- Hasil Content -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: #F0F4FF; -fx-background: #F0F4FF; -fx-border-color: transparent;">
                <content>
                    <VBox spacing="24.0" style="-fx-padding: 32 40 40 40; -fx-background-color: #F0F4FF;">

                        <!-- Section Header -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;"
                                   text="Hasil Pencarian" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblJumlahHasil"
                                   style="-fx-font-size: 13px; -fx-text-fill: #64748B;"
                                   text="Menampilkan semua hasil" />
                        </HBox>

                        <!-- Grid Kartu Kos -->
                        <FlowPane fx:id="kosGrid" hgap="24.0" vgap="24.0" prefWrapLength="1500.0">
                            <!-- Kartu Kos akan dimasukkan secara dinamis di sini -->
                        </FlowPane>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
