<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #F8FAFC;"
            stylesheets="@../../css/style.css"
            fx:controller="com.kosku.controller.pemilik.MainMenuPemilikController"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <fx:include source="navbarPemilik.fxml" />
   </top>
   <right>
      <ScrollPane fitToWidth="true"
                  style="-fx-background-color: transparent; -fx-background: #F8FAFC; -fx-border-color: transparent;"
                  BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="30.0">
               <padding>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </padding>
               <children>

                  <!-- Welcome Section -->
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Ringkasan Bisnis Anda"
                               style="-fx-text-fill: #192338; -fx-font-size: 24px; -fx-font-weight: bold;" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;"
                               text="Pantau status operasional kos Anda secara real-time." />
                     </children>
                  </VBox>

                  <!-- Stats Cards -->
                  <HBox spacing="20.0">
                     <children>

                        <!-- Card 1: Total Properti -->
                        <VBox alignment="CENTER_LEFT" prefHeight="120.0" prefWidth="220.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(25,35,56,0.08), 10, 0, 0, 4); -fx-border-color: #E8EDF5; -fx-border-radius: 15; -fx-border-width: 1;">
                           <padding>
                              <Insets left="20.0" right="20.0" />
                           </padding>
                           <children>
                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Total Properti Kos" />
                              <Label text="3"
                                     style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E2E4F;" />
                              <Label style="-fx-text-fill: #10B981; -fx-font-size: 11px;" text="↑ Aktif &amp; Terverifikasi" />
                           </children>
                        </VBox>

                        <!-- Card 2: Kamar Terisi -->
                        <VBox alignment="CENTER_LEFT" prefHeight="120.0" prefWidth="220.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(25,35,56,0.08), 10, 0, 0, 4); -fx-border-color: #E8EDF5; -fx-border-radius: 15; -fx-border-width: 1;">
                           <padding>
                              <Insets left="20.0" right="20.0" />
                           </padding>
                           <children>
                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Kamar Terisi" />
                              <Label style="-fx-text-fill: #2D6BE4; -fx-font-size: 28px; -fx-font-weight: bold;" text="12" />
                              <Label style="-fx-text-fill: #2D6BE4; -fx-font-size: 11px;" text="📈 Dari kapasitas total" />
                           </children>
                        </VBox>

                        <!-- Card 3: Kamar Kosong -->
                        <VBox alignment="CENTER_LEFT" prefHeight="120.0" prefWidth="220.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(25,35,56,0.08), 10, 0, 0, 4); -fx-border-color: #E8EDF5; -fx-border-radius: 15; -fx-border-width: 1;">
                           <padding>
                              <Insets left="20.0" right="20.0" />
                           </padding>
                           <children>
                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Kamar Kosong" />
                              <Label style="-fx-text-fill: #EF4444; -fx-font-size: 28px; -fx-font-weight: bold;" text="5" />
                              <Label style="-fx-text-fill: #EF4444; -fx-font-size: 11px;" text="⚠ Segera promosikan" />
                           </children>
                        </VBox>

                        <!-- Card 4: Booking Menunggu -->
                        <VBox alignment="CENTER_LEFT" prefHeight="120.0" prefWidth="220.0" spacing="10.0"
                              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(25,35,56,0.08), 10, 0, 0, 4); -fx-border-color: #E8EDF5; -fx-border-radius: 15; -fx-border-width: 1;">
                           <padding>
                              <Insets left="20.0" right="20.0" />
                           </padding>
                           <children>
                              <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Booking Menunggu" />
                              <Label style="-fx-text-fill: #F59E0B; -fx-font-size: 28px; -fx-font-weight: bold;" text="2" />
                              <Label style="-fx-text-fill: #F59E0B; -fx-font-size: 11px;" text="⏳ Perlu konfirmasi" />
                           </children>
                        </VBox>

                     </children>
                  </HBox>

                  <!-- Main Content Area -->
                  <HBox spacing="30.0">
                     <children>

                        <!-- Recent Bookings Table -->
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(25,35,56,0.07), 10, 0, 0, 4); -fx-border-color: #E8EDF5; -fx-border-radius: 15; -fx-border-width: 1;">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label text="📋 Booking Terbaru"
                                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button style="-fx-background-color: #EEF3FF; -fx-text-fill: #2D6BE4; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 14 6 14; -fx-border-color: #C5D8FF; -fx-border-radius: 8;"
                                            text="Lihat Semua" mnemonicParsing="false" />
                                 </children>
                              </HBox>
                              <TableView prefHeight="300.0"
                                         style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13px;">
                                 <columns>
                                    <TableColumn prefWidth="150.0" text="Penyewa" />
                                    <TableColumn prefWidth="120.0" text="Kos" />
                                    <TableColumn prefWidth="100.0" text="Kamar" />
                                    <TableColumn prefWidth="120.0" text="Tgl Masuk" />
                                    <TableColumn prefWidth="100.0" text="Status" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>

                        <!-- Quick Actions -->
                        <VBox prefWidth="300.0" spacing="15.0">
                           <children>
                              <Label text="⚡ Aksi Cepat"
                                     style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" />

                              <Button maxWidth="Infinity" prefHeight="50.0" mnemonicParsing="false"
                                      onAction="#handleTambahKos"
                                      style="-fx-background-color: linear-gradient(to right, #1E4DB7, #2D6BE4); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(45,107,228,0.3), 10, 0, 0, 4);"
                                      text="＋ Tambah Kos Baru" />

                              <Button maxWidth="Infinity" prefHeight="50.0" mnemonicParsing="false"
                                      onAction="#handleKelolaKamar"
                                      style="-fx-background-color: white; -fx-text-fill: #31487A; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #C7D2FE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand;"
                                      text="🛏 Kelola Kamar" />

                              <Button maxWidth="Infinity" prefHeight="50.0" mnemonicParsing="false"
                                      onAction="#handleLihatLaporan"
                                      style="-fx-background-color: white; -fx-text-fill: #31487A; -fx-font-size: 13px; -fx-font-weight: bold; -fx-border-color: #C7D2FE; -fx-border-radius: 12; -fx-background-radius: 12; -fx-cursor: hand;"
                                      text="📊 Lihat Laporan" />

                              <!-- Tips Box sesuai palette -->
                              <VBox spacing="10.0"
                                    style="-fx-background-color: #EFF6FF; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #BFDBFE; -fx-border-radius: 12; -fx-border-width: 1;">
                                 <children>
                                    <Label style="-fx-text-fill: #1E4DB7; -fx-font-weight: bold; -fx-font-size: 13px;"
                                           text="💡 Tips Pemilik" />
                                    <Label style="-fx-text-fill: #1E2E4F; -fx-font-size: 12px;"
                                           text="Pastikan foto kos Anda menarik untuk menarik lebih banyak penyewa."
                                           wrapText="true" />
                                 </children>
                              </VBox>

                           </children>
                        </VBox>

                     </children>
                  </HBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </right>
</BorderPane>
