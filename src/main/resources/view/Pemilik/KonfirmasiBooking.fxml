<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosku.controller.pemilik.KonfirmasiBookingController">
    <top>
        <fx:include fx:id="navbar" source="navbarPemilik.fxml" />
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="main-container">
            <content>
                <VBox spacing="25.0" styleClass="page-content">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <Button fx:id="btnKembali" onAction="#handleKembali" styleClass="btn-outline" text="← Kembali" />
                                <VBox spacing="5.0">
                                    <children>
                                        <Label styleClass="label-title" text="Konfirmasi Booking Pending" />
                                        <Label styleClass="text-muted" text="Review dan berikan keputusan (Terima/Tolak) untuk booking baru yang masuk." />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Separator />

                        <!-- Container for dynamic cards -->
                        <VBox fx:id="vboxContainer" spacing="20.0" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
