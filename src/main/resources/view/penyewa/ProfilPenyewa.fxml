<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.kosku.controller.penyewa.ProfilController"
    stylesheets="@../../css/style.css">

    <top>
        <fx:include source="NavbarPenyewa.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: #F0F4FF; -fx-background: #F0F4FF;"
            BorderPane.alignment="CENTER">
            <content>
                <VBox alignment="TOP_CENTER" spacing="40.0"
                    style="-fx-background-color: #F0F4FF; -fx-padding: 40 60 60 60;">

                    <!-- Header -->
                    <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;"
                        text="Profil Saya" />

                    <HBox alignment="TOP_CENTER" spacing="40.0">

                        <!-- Left: Profile Card -->
                        <VBox alignment="CENTER" prefWidth="360.0" spacing="16.0"
                            style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40 28 40 28; -fx-effect: dropshadow(three-pass-box, rgba(45,107,228,0.12), 20, 0, 0, 6);">

                            <ImageView fitHeight="130.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="false">
                                <image>
                                    <Image url="@../../images/tesProfile.png" />
                                </image>
                                <clip>
                                    <Circle centerX="65" centerY="65" radius="65" />
                                </clip>
                            </ImageView>

                            <Label fx:id="lblNamaProfil"
                                style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A2744; -fx-wrap-text: true; -fx-alignment: CENTER;"
                                text="..." />
                            <Label fx:id="lblEmailProfil"
                                style="-fx-font-size: 13px; -fx-text-fill: #888;"
                                text="..." />

                            <Separator style="-fx-opacity: 0.3;" />

                            <Label style="-fx-background-color: #EEF3FF; -fx-text-fill: #2D6BE4; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 20 7 20; -fx-background-radius: 20;"
                                text="🏠  Penyewa Aktif" />
                        </VBox>

                        <!-- Right: Forms -->
                        <VBox prefWidth="820.0" spacing="28.0">

                            <!-- Card Informasi Pribadi -->
                            <VBox spacing="22.0"
                                style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 36; -fx-effect: dropshadow(three-pass-box, rgba(45,107,228,0.10), 20, 0, 0, 6);">

                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #2D6BE4; -fx-background-color: #EEF3FF; -fx-padding: 5 14; -fx-background-radius: 20;"
                                        text="✏️  Edit Profil" />
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;"
                                        text="Informasi Pribadi" />
                                </HBox>

                                <!-- Nama -->
                                <VBox spacing="8.0">
                                    <Label style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: bold;"
                                        text="Nama Lengkap" />
                                    <TextField fx:id="tfNama" prefHeight="48.0"
                                        promptText="Masukkan nama lengkap..."
                                        style="-fx-font-size: 15px; -fx-background-radius: 10; -fx-border-color: #D0D9E8; -fx-border-radius: 10; -fx-padding: 0 14;" />
                                </VBox>

                                <!-- Email + NoHP -->
                                <HBox spacing="20.0">
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: bold;"
                                            text="Email" />
                                        <TextField fx:id="tfEmail" prefHeight="48.0"
                                            promptText="Masukkan email..."
                                            style="-fx-font-size: 15px; -fx-background-radius: 10; -fx-border-color: #D0D9E8; -fx-border-radius: 10; -fx-padding: 0 14;" />
                                    </VBox>
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: bold;"
                                            text="Nomor HP" />
                                        <TextField fx:id="tfNoHp" prefHeight="48.0"
                                            promptText="Masukkan nomor HP..."
                                            style="-fx-font-size: 15px; -fx-background-radius: 10; -fx-border-color: #D0D9E8; -fx-border-radius: 10; -fx-padding: 0 14;" />
                                    </VBox>
                                </HBox>

                                <HBox spacing="12.0">
                                    <Button mnemonicParsing="false" onAction="#simpanProfil"
                                        style="-fx-background-color: #2D6BE4; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12 32;"
                                        text="💾  Simpan Perubahan" />
                                    <Button mnemonicParsing="false" onAction="#batal"
                                        style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12 24;"
                                        text="Batal" />
                                </HBox>
                            </VBox>

                            <!-- Card Ubah Password -->
                            <VBox spacing="22.0"
                                style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 36; -fx-effect: dropshadow(three-pass-box, rgba(45,107,228,0.10), 20, 0, 0, 6);">

                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #EF4444; -fx-background-color: #FEF2F2; -fx-padding: 5 14; -fx-background-radius: 20;"
                                        text="🔒  Keamanan" />
                                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;"
                                        text="Ubah Password" />
                                </HBox>

                                <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;"
                                    text="Kosongkan semua field password jika tidak ingin mengubah password." />

                                <HBox spacing="20.0">
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: bold;"
                                            text="Password Lama" />
                                        <PasswordField fx:id="pfPasswordLama" prefHeight="48.0"
                                            promptText="Password saat ini..."
                                            style="-fx-font-size: 15px; -fx-background-radius: 10; -fx-border-color: #D0D9E8; -fx-border-radius: 10; -fx-padding: 0 14;" />
                                    </VBox>
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: bold;"
                                            text="Password Baru" />
                                        <PasswordField fx:id="pfPasswordBaru" prefHeight="48.0"
                                            promptText="Min. 6 karakter..."
                                            style="-fx-font-size: 15px; -fx-background-radius: 10; -fx-border-color: #D0D9E8; -fx-border-radius: 10; -fx-padding: 0 14;" />
                                    </VBox>
                                    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: bold;"
                                            text="Konfirmasi Password" />
                                        <PasswordField fx:id="pfKonfirmasiPassword" prefHeight="48.0"
                                            promptText="Ulangi password baru..."
                                            style="-fx-font-size: 15px; -fx-background-radius: 10; -fx-border-color: #D0D9E8; -fx-border-radius: 10; -fx-padding: 0 14;" />
                                    </VBox>
                                </HBox>

                                <Button mnemonicParsing="false" onAction="#ubahPassword"
                                    style="-fx-background-color: #1A3A6B; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 12 32;"
                                    text="🔐  Ubah Password" />
                            </VBox>

                        </VBox>
                    </HBox>

                    <!-- Footer -->
                    <HBox alignment="CENTER" prefHeight="70.0"
                        style="-fx-background-color: #1A3A6B; -fx-padding: 0 60; -fx-background-radius: 16;">
                        <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"
                            text="© 2024 KosKurniawan — Semua Hak Dilindungi" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13px;"
                            text="Hubungi Kami: 0812-3456-7890" />
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
