<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosku.controller.penyewa.DetailBookingController">

    <!-- Top Navigation Bar -->
    <top>
        <fx:include source="NavbarPenyewa.fxml" />
    </top>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="24.0" style="-fx-padding: 40 80 80 80;">
                    
                    <!-- Title Section -->
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Detail Pembayaran" />
                    </HBox>

                    <!-- Main Container: 2 Columns -->
                    <HBox spacing="32.0" alignment="TOP_CENTER">
                        
                        <!-- Left Column: Payment Form -->
                        <VBox prefWidth="700.0" spacing="24.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                            
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="💳 Pilih Metode Pembayaran" />

                            <!-- Dates Info -->
                            <HBox spacing="20.0">
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Tanggal Mulai" />
                                    <TextField fx:id="tfTanggalMulai" editable="false" style="-fx-background-color: #F1F5F9; -fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #475569;" />
                                </VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 14px; -fx-text-fill: #64748B;" text="Tanggal Selesai" />
                                    <TextField fx:id="tfTanggalSelesai" editable="false" style="-fx-background-color: #F1F5F9; -fx-padding: 10; -fx-background-radius: 6; -fx-text-fill: #475569;" />
                                </VBox>
                            </HBox>

                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155; -fx-padding: 16 0 0 0;" text="Metode Pembayaran" />

                            <!-- Payment Methods Grid -->
                            <GridPane hgap="16.0" vgap="16.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <!-- ToggleGroup for methods -->
                                <fx:define>
                                    <ToggleGroup fx:id="paymentGroup" />
                                </fx:define>

                                <!-- Method 1: Transfer Bank -->
                                <ToggleButton fx:id="btnBank" toggleGroup="$paymentGroup" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16; -fx-cursor: hand;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <graphic>
                                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #D92D20;" text="🏦 Transfer Bank" />
                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="BCA, Mandiri, BNI, BRI" />
                                        </VBox>
                                    </graphic>
                                </ToggleButton>

                                <!-- Method 2: Cash -->
                                <ToggleButton fx:id="btnCash" toggleGroup="$paymentGroup" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16; -fx-cursor: hand;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <graphic>
                                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #D92D20;" text="💵 Tunai / Cash" />
                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="Bayar langsung ke pemilik" />
                                        </VBox>
                                    </graphic>
                                </ToggleButton>

                                <!-- Method 3: QRIS -->
                                <ToggleButton fx:id="btnQris" toggleGroup="$paymentGroup" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16; -fx-cursor: hand;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <graphic>
                                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #D92D20;" text="📱 QRIS" />
                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="Scan dengan aplikasi apa saja" />
                                        </VBox>
                                    </graphic>
                                </ToggleButton>

                                <!-- Method 4: E-Wallet -->
                                <ToggleButton fx:id="btnEwallet" toggleGroup="$paymentGroup" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16; -fx-cursor: hand;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <graphic>
                                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #D92D20;" text="💳 E-Wallet" />
                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="OVO, GoPay, Dana, LinkAja" />
                                        </VBox>
                                    </graphic>
                                </ToggleButton>
                            </GridPane>

                            <!-- Status Box -->
                            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #F8FAFC; -fx-padding: 16; -fx-background-radius: 8;">
                                <Label style="-fx-font-size: 16px;" text="ℹ️" />
                                <Label fx:id="lblStatusPembayaran" style="-fx-font-size: 14px; -fx-text-fill: #475569;" text="Status: Menunggu Pembayaran. Silakan pilih metode pembayaran." wrapText="true" />
                            </HBox>

                        </VBox>

                        <!-- Right Column: Summary Card -->
                        <VBox prefWidth="400.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                            
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #B45309; -fx-background-color: #FEF3C7; -fx-padding: 6 12; -fx-background-radius: 20; -fx-alignment: center;" text="DISEWA" maxWidth="Infinity" />

                            <Label fx:id="lblNamaKos" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Nama Kos" />
                            
                            <HBox spacing="8.0" alignment="BOTTOM_LEFT">
                                <Label fx:id="lblTotalHarga" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #EAB308;" text="Rp 0" />
                                <Label fx:id="lblDurasiSewa" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8; -fx-padding: 0 0 6 0;" text="/ Bulan" />
                            </HBox>

                            <Separator style="-fx-padding: 10 0 10 0;" />

                            <VBox spacing="12.0">
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <Label text="✅" style="-fx-text-fill: #EAB308;" />
                                    <Label fx:id="lblKamarDetail" style="-fx-font-size: 14px; -fx-text-fill: #475569;" text="Kamar: -" />
                                </HBox>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <Label text="✅" style="-fx-text-fill: #EAB308;" />
                                    <Label fx:id="lblAlamatKos" style="-fx-font-size: 14px; -fx-text-fill: #475569;" text="Alamat Kos" wrapText="true" />
                                </HBox>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <Label text="✅" style="-fx-text-fill: #EAB308;" />
                                    <Label style="-fx-font-size: 14px; -fx-text-fill: #475569;" text="Fasilitas Sesuai Deskripsi" />
                                </HBox>
                            </VBox>

                            <Region VBox.vgrow="ALWAYS" minHeight="40" />

                            <Button fx:id="btnBayar" onAction="#handleBayar" maxWidth="Infinity" style="-fx-background-color: #EAB308; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14; -fx-background-radius: 8; -fx-cursor: hand;" text="🔒 Konfirmasi Pembayaran" />
                            
                            <Button onAction="#handleKembali" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 14px; -fx-padding: 10; -fx-cursor: hand;" text="← Batal &amp; Kembali" />
                            
                        </VBox>
                        
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
