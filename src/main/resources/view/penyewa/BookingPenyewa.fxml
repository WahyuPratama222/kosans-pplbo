<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosku.controller.penyewa.BookingPenyewaController">

    <top>
        <fx:include source="NavbarPenyewa.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #F0F4FF; -fx-background: #F0F4FF;" BorderPane.alignment="CENTER">
            <content>
                <VBox alignment="TOP_CENTER" spacing="0.0" style="-fx-background-color: #F0F4FF; -fx-padding: 40 80 60 80;">

                    <!-- Header Section -->
                    <VBox spacing="15.0" alignment="CENTER_LEFT">
                        <VBox.margin>
                            <Insets bottom="30.0" />
                        </VBox.margin>
                        <children>
                            <Button mnemonicParsing="false" onAction="#handleKembali" style="-fx-background-color: white; -fx-text-fill: #1A3A6B; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" text="⬅ Kembali" />
                            <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="✨ Formulir Booking Kos" />
                            <Label style="-fx-font-size: 16px; -fx-text-fill: #666;" text="Lengkapi formulir di bawah untuk melakukan booking kos pilihan Anda" />
                        </children>
                    </VBox>

                    <!-- Main Content: 2 Column Layout -->
                    <HBox spacing="30.0" prefWidth="1760.0">
                        <children>

                            <!-- LEFT: Kos Preview Card -->
                            <VBox prefWidth="500.0" minWidth="500.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 8);">
                                <children>

                                    <!-- Kos Image -->
                                    <ImageView fx:id="ivFotoKosPreview" fitHeight="280.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="false">
                                        <image>
                                            <Image url="@../../images/tesKos.png" />
                                        </image>
                                    </ImageView>

                                    <!-- Kos Info -->
                                    <VBox spacing="18.0" style="-fx-padding: 28;">
                                        <children>
                                            <!-- Title -->
                                            <Label fx:id="lblNamaKosPreview" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="Nama Kos" />
                                            <Label fx:id="lblAlamatPreview" style="-fx-font-size: 14px; -fx-text-fill: #666;" text="📍 Alamat Kos" />

                                            <!-- Badges -->
                                            <HBox spacing="10.0">
                                                <children>
                                                    <Label fx:id="lblTipeKosPreview" style="-fx-background-color: #2D6BE4; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14 6 14; -fx-background-radius: 16;" text="🚹 Putra" />
                                                    <Label fx:id="lblRatingPreview" style="-fx-background-color: #FFF3CD; -fx-text-fill: #856404; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 14 6 14; -fx-background-radius: 16;" text="⭐ 4.9" />
                                                </children>
                                            </HBox>

                                            <Separator prefWidth="200.0" style="-fx-padding: 5 0 5 0;" />

                                            <!-- Price Section -->
                                            <VBox spacing="6.0" style="-fx-background-color: #F0F4FF; -fx-padding: 16; -fx-background-radius: 12;">
                                                <children>
                                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-font-weight: bold;" text="💰 Harga per Bulan" />
                                                    <Label fx:id="lblHargaPreview" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16A34A;" text="Rp 0" />
                                                </children>
                                            </VBox>

                                            <!-- Facilities -->
                                            <!-- Facilities -->
                                            <VBox spacing="12.0" style="-fx-background-color: #FFF8F0; -fx-padding: 16; -fx-background-radius: 12;">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="🏠 Fasilitas" />
                                                    <!-- TODO: Load facilities dynamically from kos data -->
                                                    <VBox spacing="8.0" style="-fx-padding: 0 0 0 0;">
                                                        <children>
                                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #333;" text="✅ WiFi Gratis" />
                                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #333;" text="✅ Listrik Termasuk" />
                                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #333;" text="✅ Dapur Bersama" />
                                                            <Label style="-fx-font-size: 13px; -fx-text-fill: #333;" text="✅ Ruang Tamu" />
                                                        </children>
                                                    </VBox>
                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>

                            <!-- RIGHT: Booking Form -->
                            <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                                <children>

                                    <!-- Personal Information Section -->
                                    <VBox spacing="20.0" style="-fx-background-color: #F0F4FF; -fx-background-radius: 20; -fx-padding: 30; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 20;">
                                        <children>
                                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="📋 Informasi Pribadi" />
                                            <Separator prefWidth="200.0" style="-fx-padding: 0 0 5 0;" />

                                            <!-- Full Name -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Nama Lengkap *" />
                                                    <TextField fx:id="tfNamaLengkap" promptText="Masukkan nama lengkap Anda" style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white; -fx-focus-color: #2D6BE4; -fx-faint-focus-color: rgba(45, 107, 228, 0.1);" />
                                                </children>
                                            </VBox>

                                            <!-- Phone Number -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Nomor Telepon *" />
                                                    <TextField fx:id="tfNoTelepon" promptText="Contoh: 08123456789" style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white; -fx-focus-color: #2D6BE4; -fx-faint-focus-color: rgba(45, 107, 228, 0.1);" />
                                                </children>
                                            </VBox>

                                            <!-- Email -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Email *" />
                                                    <TextField fx:id="tfEmail" promptText="Contoh: nama@email.com" style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white; -fx-focus-color: #2D6BE4; -fx-faint-focus-color: rgba(45, 107, 228, 0.1);" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>

                                    <!-- Booking Details Section -->
                                    <VBox spacing="20.0" style="-fx-background-color: #F8F9FF; -fx-background-radius: 20; -fx-padding: 30; -fx-border-color: #E8EDF5; -fx-border-width: 2; -fx-border-radius: 20;">
                                        <children>
                                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="📅 Detail Booking" />
                                            <Separator prefWidth="200.0" style="-fx-padding: 0 0 5 0;" />

                                            <!-- Kamar Selection -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Pilih Kamar *" />
                                                    <ComboBox fx:id="cbKamar" promptText="Pilih kamar yang tersedia" style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white;" prefWidth="500.0" />
                                                </children>
                                            </VBox>

                                            <!-- Duration Selection -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Durasi Sewa *" />
                                                    <ComboBox fx:id="cbDurasi" promptText="Pilih durasi sewa" style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white;" prefWidth="500.0" />
                                                </children>
                                            </VBox>

                                            <!-- Start Date -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Tanggal Mulai Sewa *" />
                                                    <DatePicker fx:id="dpTanggalMulai" style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white;" prefWidth="500.0" />
                                                </children>
                                            </VBox>

                                            <!-- Estimated End Date (Read-only) -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Tanggal Berakhir (Otomatis Terhitung)" />
                                                    <TextField fx:id="tfTanggalBerakhir" editable="false" style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #FFFAF0; -fx-text-fill: #1A3A6B; -fx-font-weight: bold;" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>

                                    <!-- Additional Information Section -->
                                    <VBox spacing="20.0" style="-fx-background-color: #FFF8F0; -fx-background-radius: 20; -fx-padding: 30; -fx-border-color: #F5DCC7; -fx-border-width: 2; -fx-border-radius: 20;">
                                        <children>
                                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="💬 Informasi Tambahan" />
                                            <Separator prefWidth="200.0" style="-fx-padding: 0 0 5 0;" />

                                            <!-- Special Requests -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Catatan/Permintaan Khusus" />
                                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #888;" text="Tambahkan catatan khusus atau permintaan yang ingin Anda sampaikan (opsional)" />
                                                    <TextArea fx:id="taKatatan" prefRowCount="5" promptText="Contoh: Preference lokasi kamar, amenities khusus, atau pertanyaan lainnya..." style="-fx-padding: 14; -fx-font-size: 14px; -fx-border-color: #F5CCA0; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: white; -fx-control-inner-background: white; -fx-focus-color: #2D6BE4; -fx-faint-focus-color: rgba(45, 107, 228, 0.1);" wrapText="true" />
                                                </children>
                                            </VBox>

                                            <!-- Terms & Conditions -->
                                            <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #F5CCA0; -fx-border-width: 1; -fx-border-radius: 10;">
                                                <children>
                                                    <CheckBox fx:id="cbSetuju" style="-fx-font-size: 14px; -fx-text-fill: #333; -fx-font-weight: bold;" text="Saya setuju dengan syarat dan ketentuan berlaku *" />
                                                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-padding: 0 0 0 25;" text="Dengan mengajukan booking, Anda menyetujui kebijakan pembayaran, prosedur verifikasi, dan syarat lainnya yang berlaku di platform ini." wrapText="true" />
                                                </children>
                                            </VBox>

                                        </children>
                                    </VBox>

                                </children>
                            </VBox>

                        </children>
                    </HBox>

                    <!-- Summary & Action Section -->
                    <VBox spacing="20.0" style="-fx-background-color: linear-gradient(to right, #F0F4FF, #FFF8F0); -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 8); -fx-border-color: #D0DCF3; -fx-border-width: 2; -fx-border-radius: 20;">
                        <VBox.margin>
                            <Insets top="30.0" />
                        </VBox.margin>
                        <children>
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="💰 Ringkasan Booking" />
                            <Separator prefWidth="200.0" style="-fx-padding: 0 0 10 0;" />

                            <!-- Price Summary -->
                            <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #E8EDF5; -fx-border-width: 1; -fx-border-radius: 15;">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="0.0">
                                        <children>
                                            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="📌 Harga per Bulan" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblHargaBulanan" style="-fx-font-size: 15px; -fx-text-fill: #333; -fx-font-weight: bold;" text="Rp 0" />
                                        </children>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" spacing="0.0">
                                        <children>
                                            <Label style="-fx-font-size: 14px; -fx-text-fill: #666;" text="📅 Jumlah Bulan" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblJumlahBulan" style="-fx-font-size: 15px; -fx-text-fill: #333; -fx-font-weight: bold;" text="0 Bulan" />
                                        </children>
                                    </HBox>

                                    <Separator style="-fx-padding: 5 0 5 0;" />

                                    <HBox alignment="CENTER_LEFT" spacing="0.0">
                                        <children>
                                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="💳 Total Biaya" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblTotalBiaya" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16A34A;" text="Rp 0" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <!-- Action Buttons -->
                            <HBox spacing="15.0" alignment="CENTER_RIGHT">
                                <children>
                                    <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="50.0" prefWidth="180.0" style="-fx-background-color: white; -fx-text-fill: #2D6BE4; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: #2D6BE4; -fx-border-width: 2; -fx-border-radius: 12;" text="❌ Batal" />
                                    <Button fx:id="btnSubmitBooking" mnemonicParsing="false" onAction="#handleSubmitBooking" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(to right, #16A34A, #22C55E); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(34, 197, 94, 0.4), 10, 0, 0, 4);" text="✅ Lanjut Booking" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
