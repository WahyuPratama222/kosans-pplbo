<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosku.controller.penyewa.RiwayatController" stylesheets="@../../css/style.css">

    <top>
        <fx:include source="NavbarPenyewa.fxml" />
    </top>

    <center>
        <VBox prefHeight="1010.0" spacing="0.0" style="-fx-background-color: #F0F4FF;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 36 48 24 48; -fx-background-color: white; -fx-border-color: transparent transparent #E8EDF5 transparent; -fx-border-width: 0 0 1 0;">
                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A3A6B;" text="📋 Riwayat Booking" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #888;" text="Kelola kos yang pernah Anda pesan" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <!-- Search -->
                <HBox alignment="CENTER_LEFT" prefWidth="380.0" spacing="8.0" style="-fx-background-color: #F0F4FF; -fx-background-radius: 10; -fx-padding: 10 16 10 16;">
                    <Label style="-fx-font-size: 14px;" text="🔍" />
                    <TextField fx:id="tfCariRiwayat" promptText="Cari riwayat booking..." style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-border-color: transparent;" HBox.hgrow="ALWAYS" />
                </HBox>
            </HBox>

            <!-- Custom Tabs -->
            <HBox spacing="12.0" style="-fx-padding: 24 48 16 48; -fx-background-color: #F0F4FF;">
                <Button fx:id="btnPending" onAction="#showPending" style="-fx-background-color: #2D6BE4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 24; -fx-background-radius: 24; -fx-cursor: hand;" text="⏳ Menunggu Pembayaran" />
                <Button fx:id="btnSelesai" onAction="#showSelesai" style="-fx-background-color: white; -fx-text-fill: #555; -fx-font-weight: bold; -fx-padding: 10 24; -fx-background-radius: 24; -fx-border-color: #DDD; -fx-border-radius: 24; -fx-cursor: hand;" text="✅ Selesai" />
            </HBox>

            <!-- Scroll Content -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="vboxRiwayatBooking" spacing="20.0" style="-fx-padding: 0 48 40 48;">
                        <!-- Data dinamis akan dimuat di sini -->
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
